SECURE_COOKIES=auto

# Login Google (Web application Client ID)
GOOGLE_CLIENT_ID=COLOQUE_SEU_CLIENT_ID.apps.googleusercontent.com

# Mercado Pago
MP_PUBLIC_KEY=COLOQUE_SUA_PUBLIC_KEY
MP_ACCESS_TOKEN=COLOQUE_SEU_ACCESS_TOKEN
